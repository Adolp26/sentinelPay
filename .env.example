# Copie para .env e ajuste. O .env real nunca vai para o git.
APP_ENV=development
APP_PORT=8080
# Prazo máximo por requisição (formato Go: 500ms, 2s, 1m)
APP_REQUEST_TIMEOUT=2s
# URL de conexão com o banco de dados
DATABASE_URL=postgres://sentinelpay:sentinelpay@localhost:5432/sentinelpay?sslmode=disable